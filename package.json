{
  "name": "crit-fumble-core",
  "type": "module",
  "private": true,
  "scripts": {
    "build:zip": "node scripts/build-zip.js",
    "build:three": "esbuild scripts/lib/three-bundle.entry.mjs --bundle --format=esm --minify --legal-comments=none --outfile=scripts/lib/three.bundle.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/jest.config.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/jest.config.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/jest.config.js --coverage",
    "test:foundry:provision": "node tests/integration/shared/provision-fixtures.mjs",
    "test:foundry:stage": "test -d tests/fixtures/.worlds-runtime || cp -R tests/fixtures/worlds tests/fixtures/.worlds-runtime",
    "test:foundry:up": "npm run test:foundry:stage && docker compose --env-file tests/.env.test -f tests/docker-compose.yml up -d && node tests/integration/shared/foundry-setup.mjs",
    "test:foundry": "npx playwright test --config tests/integration/playwright.config.js",
    "test:foundry:core": "npx playwright test --config tests/integration/playwright.config.js --project=core-hosted",
    "test:foundry:self": "npx playwright test --config tests/integration/playwright.config.js --project=self-hosted",
    "test:foundry:ui": "npx playwright test --config tests/integration/playwright.config.js --ui",
    "test:foundry:3d": "npx playwright test --config tests/integration/playwright.config.js --project=3d-screenshots",
    "test:foundry:down": "docker compose --env-file tests/.env.test -f tests/docker-compose.yml down && rm -rf tests/fixtures/.worlds-runtime",
    "test:foundry:all": "npm run test:foundry:up && npm run test:foundry; npm run test:foundry:down",
    "prepare": "husky"
  },
  "overrides": {
    "picomatch": "^4.0.2",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@crit-fumble/shared": "^1.8.2",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "three": "^0.184.0"
  }
}
